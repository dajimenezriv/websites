---
import { richText } from '../rich-text';
import type { ServicesBlock, SiteData } from '../types';
import { pageHref } from '../utils';
import CtaLink from './cta-link.astro';

interface Props {
  data: SiteData;
  block: ServicesBlock;
}

const { data, block } = Astro.props;
const { cta } = block;
const groups = data.blocks.groups;
---

<section class="flex justify-center bg-secondary px-6 py-24 md:px-0">
  <div class="flex w-full max-w-250 flex-col gap-10">
    <div class="flex flex-col gap-4">
      <p class="text-xs tracking-[0.25em] text-primary uppercase">
        — {block.nav}
      </p>
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <h2 class="text-5xl" set:html={richText(block.title)} />
        <p class="text-sm leading-relaxed md:w-100 md:text-end" set:html={richText(block.text)} />
      </div>
    </div>

    <div class="flex flex-col gap-10">
      {
        groups.map((group) => (
          <div>
            <div class="border-b border-primary/30 pb-2">
              <span class="text-xs tracking-[0.2em] text-primary uppercase">{group.title}</span>
            </div>

            <div>
              {group.pages.map((page, i) => (
                <div class="flex flex-col">
                  <a href={pageHref(page.slug)} class="group flex items-center justify-between gap-4 py-2">
                    <div class="flex flex-col">
                      <p class="text-base text-secondary-foreground transition-colors group-hover:text-primary">{page.title}</p>
                      <p class="text-xs leading-relaxed text-secondary-foreground/40">{page.summary}</p>
                    </div>
                    <span class="text-primary">→</span>
                  </a>
                  {i < group.pages.length - 1 && <div class="border-t border-secondary-foreground/10" />}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {
      cta && (
        <div class="flex flex-col gap-4 border-t border-secondary-foreground/10 pt-8 md:flex-row md:items-center md:justify-between">
          <CtaLink cta={cta} variant="outline" />
        </div>
      )
    }
  </div>
</section>
